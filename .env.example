# Meeting Transcriber Environment Configuration
#
# IMPORTANT: Copy this file to .env and set secure passwords!
#   cp .env.example .env
#   nano .env
#
# NEVER commit .env file to git (it's in .gitignore)

# ============================================================
# REQUIRED: PostgreSQL Database Configuration
# ============================================================
POSTGRES_DB=meetings
POSTGRES_USER=meeting_user

# REQUIRED: Set a strong password!
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ============================================================
# REQUIRED: Flask Security Configuration
# ============================================================
FLASK_ENV=production

# REQUIRED: Set a strong secret key!
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_SECURE_SECRET_KEY

# OPTIONAL: JWT Secret (for token signing)
# If not set, will use SECRET_KEY as fallback
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_JWT_SECRET

# ============================================================
# OPTIONAL: AI Model Configuration
# ============================================================

# Whisper transcription model (tiny, base, small, medium, large)
# Recommended for 8GB RAM: small
# Recommended for 4GB RAM: base
# Recommended for 16GB+ RAM: medium
WHISPER_MODEL=small

# Ollama LLM model (phi, mistral, llama2)
# Recommended for 8GB RAM: phi
# Recommended for 16GB+ RAM: mistral
# Note: You must pull the model after deployment:
#   docker exec meeting-ollama ollama pull phi
OLLAMA_MODEL=phi

# ============================================================
# OPTIONAL: Resource Management
# ============================================================

# Maximum concurrent transcription jobs (prevents RAM overload)
# Recommended for 8GB RAM: 4
# Recommended for 16GB+ RAM: 8
# Each job uses ~2-3GB RAM during processing
MAX_CONCURRENT_JOBS=4

# ============================================================
# OPTIONAL: Google Calendar Integration (Notion-style auto-record)
# ============================================================

# Required for automatic meeting detection and recording prompts
# Follow GOOGLE_CALENDAR_SETUP.md for detailed setup instructions

# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your application URL (used for OAuth callback)
# Examples:
#   http://localhost:8080 (local development)
#   http://your-vps-ip:8080 (VPS with IP)
#   https://meetings.yourdomain.com (production with domain)
APP_URL=http://localhost:8080
