# PostgreSQL Database Configuration
POSTGRES_DB=meetings
POSTGRES_USER=meeting_user
POSTGRES_PASSWORD=ChangeThisToASecurePassword123!

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=ChangeThisToARandomSecretKey456!

# Optional: Change Whisper Model (tiny, base, small, medium, large)
WHISPER_MODEL=small

# Optional: Change Ollama Model (phi, mistral, llama2)
OLLAMA_MODEL=phi
